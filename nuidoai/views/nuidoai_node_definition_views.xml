<odoo>
    <data>
        <record id="action_process_node_definitions" model="ir.actions.server">
            <field name="name">Process Definitions</field>
            <field name="model_id" ref="model_nuidoai_node_definition" />
            <field name="state">code</field>
            <field name="code">model.action_process_node_definitions()</field>
        </record>

        <record model="ir.ui.view" id="nuidoai_node_definition_form">
            <field name="name">nuidoai.node.definition.form</field>
            <field name="model">nuidoai.node.definition</field>
            <field name="arch" type="xml">
                <form string="Node Definition">
                    <sheet>
                        <group>
                            <field name="title" />
                            <field name="raw" />
                            <field name="definition" readonly="1" force_save="1"/>
                            <field name="is_processed" readonly="1" force_save="1" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="nuidoai_node_definition_search">
            <field name="name">nuidoai.node.definition.search</field>
            <field name="model">nuidoai.node.definition</field>
            <field name="arch" type="xml">
                <search>
                    <filter string="Processed" name="processed_doc_ref" domain="[('is_processed', '=', True)]" />
                    <filter string="Not Processed" name="processed_doc_ref" domain="[('is_processed', '=', False)]" />
                </search>
            </field>
        </record>

        <record model="ir.ui.view" id="nuidoai_node_definition_list">
            <field name="name">nuidoai.node.definition.list</field>
            <field name="model">nuidoai.node.definition</field>
            <field name="arch" type="xml">
                <list string="Node Definition" action="action_open_designer" type="object"
                    js_class="nuidoai_node_definition_list">
                    <header>
                        <button display="always" type="action" name="nuidoai.action_process_node_definitions" string="Process" icon="fa-play" class="oe_link"
                            confirm="Process node definitions?"
                        />
                    </header>
                    <field name="title" />
                    <field name="is_processed" />
                    <button name="editRecord" class="btn btn-primary" title="Control" width="100px" string="View Raw" type="object"/>
                </list>
            </field>
        </record>

        <record id="action_nuidoai_node_definition" model="ir.actions.act_window">
            <field name="name">NuidoAi Node Definition</field>
            <field name="path">nuidoai</field>
            <field name="res_model">nuidoai.node.definition</field>
            <field name="view_mode">list</field>
        </record>
    </data>
</odoo>