<templates xml:space="preserve">

<t t-name="nuido_base.text-input-dialog">
    <Dialog title="props.title">
        <div class="mb-3 row">
            <label for="document-name" class="col-sm-2 col-form-label"><t t-out="props.label"/></label>
            <div class="col-sm-10">
                <input type="text" class="form-control text-primary border-primary" id="document-name" t-model="state.text" />
            </div>
        </div>

        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="onClickApply">
                Ok
            </button>
            <button class="btn btn-secondary" t-on-click="onClickCancel">
                Cancel
            </button>
        </t>
    </Dialog>
</t>

</templates>