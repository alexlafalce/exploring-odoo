<templates xml:space="preserve">
    <t t-name="nuidoai.label-section" t-inherit="nuido.node-section" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-section-content')]" position="inside">
            <div class="mb-2 py-1">
                <label t-attf-id="label-{{props.section.id}}"><t t-out="props.section.label"/></label>
            </div>
        </xpath>
    </t>
</templates>
