<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="nuido.node-section">
        <div class="node-section">
            <div class="input-container">
                <t t-if="['in', 'inout'].includes(props.section.direction)">
                    <Port port="findInPortById(props.section.inPortId)"/>
                </t>
            </div>
            <div t-att-id="props.section.id" class="node-section-content">
            </div>
            <div class="output-container">
                <t t-if="['out', 'inout'].includes(props.section.direction)">
                    <Port port="findOutPortById(props.section.outPortId)"/>
                </t>
            </div>
        </div>
    </t>
</templates>
