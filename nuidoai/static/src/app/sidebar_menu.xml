<templates xml:space="preserve">
    <t t-name="nuidoai.sidebar-menu">
        <div class="sidebar-menu-root d-flex flex-column flex-shrink-0 position-relative z-3">
            <div class="menu-handle">
                <button type="button" class="btn btn-primary" t-on-click="toggleSidebar">
                    <i class="fa fa-bars"></i>
                </button>
            </div>
            <ul id="sidebar-nav" class="nav nav-pills m-3 overflow-y-scroll overflow-x-hidden">
                <div class="nav-item nav-category">
                    <h5 class="mb-0">
                        <a class="my-1" type="button" t-on-click="() => toggleCategory('sidebar-cat--1')">
                            Document Info
                        </a>
                    </h5>
                </div>
                <div id="sidebar-cat--1" t-attf-class="collapse show">
                    <li class="nav-item">
                        Title: <t t-out="props.title"/>
                    </li>
                </div>
                <hr/>
                <t t-set="category_title" t-value="'Agents'"/>
                <t t-set="sidebar_items" t-value="agentMenuItems"/>
                <t t-call="nuidoai.sidebar-menu-items"/>

                <t t-set="category_title" t-value="'Services'"/>
                <t t-set="sidebar_items" t-value="serviceMenuItems"/>
                <t t-call="nuidoai.sidebar-menu-items"/>

                <t t-set="category_title" t-value="'Plugins'"/>
                <t t-set="sidebar_items" t-value="pluginMenuItems"/>
                <t t-call="nuidoai.sidebar-menu-items"/>

                <t t-set="category_title" t-value="'Selection Strategies'"/>
                <t t-set="sidebar_items" t-value="selectionStrategyMenuItems"/>
                <t t-call="nuidoai.sidebar-menu-items"/>

                <t t-set="category_title" t-value="'Termination Strategies'"/>
                <t t-set="sidebar_items" t-value="terminationStrategyMenuItems"/>
                <t t-call="nuidoai.sidebar-menu-items"/>
            </ul>
        </div>
    </t>

    <t t-name="nuidoai.sidebar-menu-items">
        <div class="nav-item nav-category">
            <h5 class="mb-0">
                <a class="my-1" type="button" t-on-click="() => toggleCategory('sidebar-cat-' + category_title)">
                    <t t-out="category_title"/>
                </a>
            </h5>
        </div>
        <div t-attf-id="sidebar-cat-{{category_title}}" t-attf-class="collapse show">
            <t t-foreach="sidebar_items" t-as="item" t-key="item_index">
                <li class="nav-item">
                    <MenuItem action="props.action" title="item.title" icon="item.icon" type="item.type"/>
                </li>
            </t>
        </div>
    </t>
</templates>
