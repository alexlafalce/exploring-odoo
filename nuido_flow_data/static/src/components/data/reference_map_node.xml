<templates xml:space="preserve">
    <t t-name="nuido_flow_data.reference-map-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-tag" t-attf-for="text-{{props.node.id}}-ref-key">Source Key</label>
                <input t-attf-id="text-{{props.node.id}}-ref-key" type="text" t-model="props.node.reference_key"></input>
            </div>
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-model-selector" t-att-for="modelSelectorId">Model</label>
                <ModelSelectorEx
                    id="modelSelectorId"
                    value="state.modelDescription"
                    onModelSelected.bind="onModelSelected"
                />
            </div>
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-field-selector">Reference Field</label>
                <ModelFieldSelectorEx
                    resModel="props.node.model"
                    path="props.node.field"
                    readonly="props.node.model===''"
                    followRelations="false"
                    update.bind="onModelFieldUpdate"
                    allowEmpty="true"
                />
            </div>
        </xpath>
    </t>
</templates>
