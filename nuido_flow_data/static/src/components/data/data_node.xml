<templates xml:space="preserve">
    <t t-name="nuido_flow_data.data-node" t-inherit="nuido.node" t-inherit-mode="primary">
        <xpath expr="//div[hasclass('node-content')]" position="inside">
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-key" t-attf-for="text-{{props.node.id}}-key">Key</label>
                <input class="o_input" t-attf-id="text-{{props.node.id}}-key" t-model="props.node.key"/>
            </div>
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-model-selector" t-att-for="modelSelectorId">Model</label>
                <ModelSelectorEx
                    id="modelSelectorId"
                    value="state.modelDescription"
                    onModelSelected.bind="onModelSelected"
                />
            </div>
            <div class="data-input d-flex flex-column mb-2">
                <label t-attf-id="label-{{props.node.id}}-model-selector">Fields</label>
                <ModelFieldTags
                    model="props.node.model"
                    fields="props.node.fields"
                    onAddField.bind="onFieldAdded"
                    onDeleteField.bind="onFieldDeleted"
                />
            </div>
            <div class="text-divider">Dynamic Date Filter</div>
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-dynamic-date-field-selector">Field</label>
                <ModelFieldSelectorEx
                    resModel="props.node.model"
                    path="props.node.model ? props.node.dynamic_date_field : ''"
                    readonly="props.node.model===''"
                    followRelations="false"
                    update.bind="onDynamicDateFieldUpdate"
                    allowEmpty="true"
                    filter="dynamicDateFieldFilter"
                />
            </div>
            <div class="mb-2">
                <label t-attf-id="label-{{props.node.id}}-dynamic-date-interval" t-att-for="dynamicDateIntervalInputId">Type</label>
                <select t-att-id="dynamicDateIntervalInputId" t-on-change.stop.prevent="onDynamicDateIntervalChanged" class="form-control">
                    <option value="" t-att-selected="props.node.dynamic_date_interval === ''">None</option>
                    <option value="day" t-att-selected="props.node.dynamic_date_interval === 'day'">Day</option>
                    <option value="week" t-att-selected="props.node.dynamic_date_interval === 'week'">Week</option>
                    <option value="month" t-att-selected="props.node.dynamic_date_interval === 'month'">Month</option>
                    <option value="year" t-att-selected="props.node.dynamic_date_interval === 'year'">Year</option>
                </select>
            </div>
            <div class="text-divider">Filter</div>
            <div class="mb-2">
                <DomainDialogInput id="props.node.id" label="'Domain'"
                    domain="props.node.domain" model="props.node.model" onChanged.bind="onDomainChanged"/>
            </div>
        </xpath>
    </t>
</templates>